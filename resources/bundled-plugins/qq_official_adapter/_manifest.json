{
  "manifest_version": 2,
  "id": "Mai-with-u.qq-adapter",
  "version": "0.4.1",
  "name": "QQ 官方机器人适配器",
  "description": "直连 QQ 开放平台官方 API，支持群聊与单聊的文本、@、图片、表情收发，提供禁言、撤回工具。",
  "author": {
    "name": "MaiBot Team",
    "url": "https://github.com/Mai-with-u"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/Mai-with-u/MaiBot-QQ-Adapter"
  },
  "plugin_type": "adapter",
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/icon.svg",
      "fallback": "plug",
      "background": "#E5EAEC"
    }
  },
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.8.2",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "aiohttp",
      "version_spec": ">=3.14.3"
    }
  ],
  "capabilities": [
    "component.disable",
    "component.enable",
    "message.get_by_id"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN"]
  }
}
