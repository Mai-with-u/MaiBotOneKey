{
  "name": "maibot-onekey-desktop",
  "version": "0.7.0",
  "description": "Electron shell for MaiBot OK.",
  "author": "![1779700604525](image/package/1779700604525.png)MotricSeven",
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "out/main/index.cjs",
  "scripts": {
    "dev": "bun run scripts/dev/start-dev.ts --mode pypi",
    "dev:pypi": "bun run scripts/dev/start-dev.ts --mode pypi",
    "dev:source": "bun run scripts/dev/start-dev.ts --mode source",
    "dev:source:webui": "bun run scripts/dev/start-dev.ts --mode source --local-dashboard",
    "dev:dev": "bun run scripts/dev/start-dev.ts --mode source --local-dashboard",
    "dev:build": "bun run scripts/dev/build-local-dashboard.ts",
    "dev:reset": "bun run scripts/dev/reset-dev-state.ts",
    "dev:fullreset": "bun run scripts/dev/reset-dev-state.ts --full",
    "dev:fresh": "bun run dev:reset && bun run dev",
    "dev:web": "vite --config vite.renderer.config.ts",
    "dev:ui": "vite --config vite.renderer.config.ts --open /controls.html",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.json && electron-vite build",
    "check": "bun run typecheck && bun run build",
    "preview": "electron-vite preview",
    "runtime:git": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/dev/prepare-mingit.ps1",
    "release:check": "bun run scripts/release/check-windows-payload.ts",
    "release:patch-nsis": "bun run scripts/release/patch-electron-builder-nsis.ts",
    "release:win": "bun run release:check && bun run release:patch-nsis && bun run build && bun run scripts/release/build-windows-variants.ts",
    "release:win:standard": "bun run release:win",
    "release:win:snowluma": "bun run release:check --snowluma-only && bun run release:patch-nsis && bun run build && bun run scripts/release/build-windows-variants.ts --snowluma-only",
    "pack:win": "bun run release:win",
    "test": "bun test scripts/tests"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "iconv-lite": "^0.7.2",
    "lucide-react": "^0.468.0",
    "node-pty": "^1.1.0",
    "radix-ui": "^1.4.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "smol-toml": "^1.6.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/bun": "^1.2.23",
    "@types/node": "^22.15.34",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.3",
    "@xterm/headless": "6.0.0",
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.1",
    "tailwindcss": "^4.1.13",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  },
  "build": {
    "appId": "org.maibot.onekey.desktop",
    "productName": "MaiBot OneKey",
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "compression": "store",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "files": [
      "out/**",
      "package.json",
      "node_modules/node-pty/**",
      "node_modules/node-addon-api/**"
    ],
    "extraResources": [
      {
        "from": "resources/maibot-package",
        "to": "maibot"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/tray-icon.png",
        "to": "tray-icon.png"
      },
      {
        "from": "resources/app-icons",
        "to": "app-icons"
      },
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "**/*",
          "!opencode/**",
          "!python-full/**",
          "!python/Doc/**",
          "!**/.git/**",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "modules",
        "to": "modules",
        "filter": [
          "**/*",
          "!**/.git/**",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!MaiBot/.venv/**",
          "!MaiBot/**",
          "!MaiBot/.pytest_cache/**",
          "!MaiBot/.ruff_cache/**",
          "!MaiBot/.mypy_cache/**",
          "!MaiBot/config/**",
          "!MaiBot/data/**",
          "!MaiBot/logs/**",
          "!MaiBot/dashboard/.vite/**",
          "!MaiBot/dashboard/node_modules/**",
          "!MaiBot/maibot_statistics.html",
          "!MaiBot/plugins/**",
          "!MaiBot/pytests/**",
          "!SnowLuma/config/**",
          "!SnowLuma/data/**",
          "!SnowLuma/logs/**",
          "!napcat/**",
          "!SnowLuma/.maibot-target-runtime.mjs"
        ]
      },
      {
        "from": "resources/bundled-plugins/qq_official_adapter",
        "to": "modules/MaiBot/plugins/qq_official_adapter",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!config.toml",
          "!data/**",
          "!logs/**"
        ]
      },
      {
        "from": "modules/MaiBot/plugins/snowluma-adapter",
        "to": "modules/MaiBot/plugins/snowluma-adapter",
        "filter": [
          "**/*",
          "!**/.git/**",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/config.toml",
          "!**/config.toml.*",
          "!**/config_back/**",
          "!**/data/**",
          "!**/logs/**",
          "!**/*.bak",
          "!**/*.backup*",
          "!**/*.db",
          "!**/*.sqlite",
          "!**/*.sqlite3",
          "!**/*.log"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "MaiBot-OK-${version}-win.${ext}",
      "extraResources": [
        {
          "from": "modules/napcat",
          "to": "modules/napcat",
          "filter": [
            "**/*",
            "!**/.git/**",
            "!**/__pycache__/**",
            "!**/*.pyc",
            "!**/*linux*",
            "!**/*darwin*",
            "!**/*arm64*",
            "!*.db",
            "!*.db-*",
            "!*.log",
            "!config/**",
            "!cache/**",
            "!data/**",
            "!logs/**",
            "!temp/**",
            "!tmp/**",
            "!napcat/config/**",
            "!napcat/cache/**",
            "!napcat/data/**",
            "!napcat/logs/**",
            "!napcat/temp/**",
            "!napcat/tmp/**",
            "!versions/**/resources/app/napcat/cache/**",
            "!versions/**/resources/app/napcat/config/**",
            "!versions/**/resources/app/napcat/data/**",
            "!versions/**/resources/app/napcat/logs/**",
            "!versions/**/resources/app/napcat/temp/**",
            "!versions/**/resources/app/napcat/tmp/**"
          ]
        }
      ]
    },
    "mac": {
      "icon": "resources/icon.icns",
      "extraResources": [
        {
          "from": "modules/napcat",
          "to": "modules/napcat",
          "filter": [
            "**/*",
            "!**/.git/**",
            "!**/__pycache__/**",
            "!**/*.pyc",
            "!**/*linux*",
            "!**/*win32*",
            "!**/*.bat",
            "!**/*.dll",
            "!**/*.exe",
            "!napcat-macos-launch.sh",
            "!native/dpapi/**",
            "!native/pty/**",
            "!*.db",
            "!*.db-*",
            "!*.log",
            "!config/**",
            "!cache/**",
            "!data/**",
            "!logs/**",
            "!temp/**",
            "!tmp/**",
            "!napcat/config/**",
            "!napcat/cache/**",
            "!napcat/data/**",
            "!napcat/logs/**",
            "!napcat/temp/**",
            "!napcat/tmp/**",
            "!versions/**/resources/app/napcat/cache/**",
            "!versions/**/resources/app/napcat/config/**",
            "!versions/**/resources/app/napcat/data/**",
            "!versions/**/resources/app/napcat/logs/**",
            "!versions/**/resources/app/napcat/temp/**",
            "!versions/**/resources/app/napcat/tmp/**"
          ]
        },
        {
          "from": "modules/napcat/node_modules",
          "to": "modules/napcat/node_modules",
          "filter": [
            "**/*",
            "!**/.git/**",
            "!**/*.log"
          ]
        },
        {
          "from": "resources/napcat/napcat-macos-launch.sh",
          "to": "modules/napcat/napcat-macos-launch.sh"
        },
        {
          "from": "resources/napcat/napcat.json",
          "to": "modules/napcat/config/napcat.json"
        }
      ]
    },
    "linux": {
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "include": "installer.nsh",
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "installerSidebar": "resources/installerSidebar.bmp",
      "uninstallerSidebar": "resources/installerSidebar.bmp",
      "shortcutName": "MaiBot OneKey"
    }
  }
}
